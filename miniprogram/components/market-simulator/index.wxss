.market-intro { margin-top: 8rpx; overflow-wrap: anywhere; }
.market-pair { display: flex; gap: 16rpx; margin-top: 12rpx; }
.market-field { flex: 1; min-width: 0; }
.market-label { display: block; color: #685a64; font-size: 24rpx; }
.market-input {
  box-sizing: border-box;
  height: 80rpx;
  margin-top: 6rpx;
  padding: 0 14rpx;
  border: 2rpx solid #dfced7;
  border-radius: 10rpx;
  background: #fffdfc;
  font-size: 30rpx;
}
.market-invalid { border-color: #ad261b; background: #fff8f6; }
.market-error { display: block; margin-top: 6rpx; color: #ad261b; font-size: 23rpx; }
.market-plan { padding: 16rpx 0; border-bottom: 1rpx solid #eddee6; }
.market-plan-name { display: block; color: #401c2c; font-size: 28rpx; font-weight: 700; }
.market-reference { color: #756370; font-size: 23rpx; font-weight: 400; }
.market-calculate {
  width: 100%;
  margin: 20rpx 0 0;
  padding: 16rpx 8rpx;
  border-radius: 12rpx;
  color: #fffafd;
  background: #851e3e;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.55;
}
.market-calculate::after { border: 0; }
.market-result { margin-top: 12rpx; padding: 13rpx 16rpx; border-radius: 12rpx; background: #f7eef2; }
.market-result-heading { display: flex; justify-content: space-between; align-items: center; gap: 8rpx; }
.market-state { color: #685a64; font-size: 22rpx; font-weight: 600; }
.market-triggered { color: #851e3e; }
.market-amount { display: block; color: #67203c; font-size: 31rpx; font-weight: 700; word-break: break-all; }
