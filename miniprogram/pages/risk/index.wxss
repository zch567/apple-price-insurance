.cumulative {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx 18rpx;
  padding: 12rpx 0 8rpx;
  border-bottom: 1rpx solid #e9dce3;
}
.cumulative-value { font-size: 54rpx; font-weight: 700; line-height: 1.2; }
.component { margin-top: 20rpx; }
.factor { display: flex; align-items: baseline; gap: 11rpx; }
.factor-id { color: #685a64; font-size: 23rpx; }
.factor-name { flex: 1; font-weight: 600; }
.factor-value { font-weight: 700; }
.track { height: 10rpx; background: #f2e7ec; border-radius: 8rpx; margin: 7rpx 0; }
.fill { height: 100%; background: #9e3154; border-radius: 8rpx; }
.factor-description { display: block; color: #625360; font-size: 25rpx; }
.provenance { margin-top: 14rpx; }
.source { font-size: 24rpx; }
.block-label { display: block; margin-top: 5rpx; }
.metric-caption { margin-top: 10rpx; }
.metrics { display: flex; gap: 14rpx; margin-top: 10rpx; }
.metric { flex: 1; min-width: 0; background: #f6eaf0; border-radius: 12rpx; padding: 14rpx 18rpx; }
.metric-value { display: block; font-weight: 700; font-size: 44rpx; line-height: 1.25; }
.interpretation { display: block; margin-top: 14rpx; font-size: 26rpx; }
.difference { font-weight: 700; }
.forecast-note { margin-top: 4rpx; }
